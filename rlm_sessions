#!/usr/bin/env python3
"""List and render direct-child Pi JSONL sessions without following links."""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from typing import Any, Iterator, NoReturn

sys.path.insert(0, os.fspath(Path(__file__).resolve().parent / "scripts"))

from ypi_transcript import (  # noqa: E402
    DirectoryEntry,
    PrivateSessionDirectory,
    TranscriptReadError,
)


def fail(message: str, code: int = 1) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(code)


if os.environ.get("RLM_SHARED_SESSIONS", "1") == "0":
    print("Session sharing disabled (RLM_SHARED_SESSIONS=0).", file=sys.stderr)
    raise SystemExit(0)

raw_session_dir = os.environ.get("RLM_SESSION_DIR", "")
if not raw_session_dir:
    fail("No session directory found.\n  RLM_SESSION_DIR=<not set>")

session_dir = Path(raw_session_dir).absolute()
try:
    session_owner = PrivateSessionDirectory(session_dir)
except (OSError, TranscriptReadError) as error:
    fail(f"Session directory must be a regular non-symlink path: {session_dir}: {error}")

trace_id = re.sub(
    r"[^a-zA-Z0-9._-]",
    "_",
    os.environ.get("RLM_TRACE_ID", ""),
)


def session_entries(trace_only: bool = False) -> list[DirectoryEntry]:
    try:
        return session_owner.entries(prefix=trace_id if trace_only else "")
    except (OSError, TranscriptReadError) as error:
        fail(f"Session entries must be private, singly-linked regular files: {error}")


def checked_name(value: str) -> str:
    try:
        return session_owner.checked_name(value)
    except TranscriptReadError as error:
        fail(str(error))


def records(name: str) -> Iterator[dict[str, Any]]:
    try:
        values, _metrics = session_owner.read(checked_name(name))
    except (OSError, TranscriptReadError) as error:
        fail(
            "Session is not a private, singly-linked direct-child regular "
            f"file: {json.dumps(name)}: {error}"
        )
    yield from values


def text_content(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return str(content)
    return "".join(
        str(part.get("text", ""))
        for part in content
        if isinstance(part, dict)
    )


def render(name: str) -> None:
    for record in records(name):
        if record.get("type") == "session":
            print(f"=== Session: {record.get('timestamp', '?')} ===")
            print(f"    cwd: {record.get('cwd', '?')}")
            print()
            continue
        if record.get("type") != "message":
            continue
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        role = str(message.get("role", "?"))
        content = message.get("content", "")
        if role == "toolResult":
            tool = message.get("toolName", "?")
            text = text_content(content)
            if len(text) > 500:
                text = f"{text[:500]}... [truncated]"
            print(f"[{tool} result]: {text}\n")
            continue
        if isinstance(content, str):
            print(f"{role}: {content}\n")
            continue
        if not isinstance(content, list):
            continue
        for part in content:
            if not isinstance(part, dict):
                continue
            part_type = part.get("type", "")
            if part_type == "thinking":
                continue
            if part_type == "text":
                text = str(part.get("text", ""))
                if len(text) > 1000:
                    text = f"{text[:1000]}... [truncated]"
                print(f"{role}: {text}\n")
            elif part_type == "toolCall":
                name_value = part.get("name", "?")
                arguments = part.get("arguments", {})
                rendered = json.dumps(arguments, ensure_ascii=True)
                if len(rendered) > 200:
                    rendered = f"{rendered[:200]}..."
                print(f"{role}: [{name_value}] {rendered}\n")


def list_sessions(trace_only: bool) -> None:
    if trace_only and trace_id:
        print(f"Sessions for trace {trace_id}:")
    else:
        print(f"All sessions in {session_dir}:")
    print()
    for entry in session_entries(trace_only):
        messages = 0
        timestamp = "?"
        for index, record in enumerate(records(entry.name)):
            if index == 0:
                timestamp = str(record.get("timestamp", "?"))[:19]
            if record.get("type") == "message":
                messages += 1
        display_name = json.dumps(entry.name, ensure_ascii=True)
        print(
            f"  {display_name:<52} {entry.size:6d} bytes  "
            f"{messages:3d} msgs  {timestamp}"
        )


def grep_sessions(pattern_text: str, trace_only: bool) -> None:
    try:
        pattern = re.compile(pattern_text, re.IGNORECASE)
    except re.error as error:
        fail(f"Invalid regular expression: {error}", 2)
    for entry in session_entries(trace_only):
        matches: list[str] = []
        for record in records(entry.name):
            if record.get("type") != "message":
                continue
            message = record.get("message")
            if not isinstance(message, dict):
                continue
            role = str(message.get("role", "?"))
            content = message.get("content", "")
            if isinstance(content, str):
                if pattern.search(content):
                    matches.append(f"{role}: {content[:150]}")
                continue
            if not isinstance(content, list):
                continue
            for part in content:
                text = part.get("text", "") if isinstance(part, dict) else ""
                if isinstance(text, str) and text and pattern.search(text):
                    matches.append(f"{role}: {text[:150]}")
        if matches:
            print(f"--- {json.dumps(entry.name, ensure_ascii=True)} ---")
            print("\n".join(matches))
            print()


arguments = sys.argv[1:]
command = arguments.pop(0) if arguments else "list"
if command in ("list", "--trace"):
    if arguments:
        fail("Usage: rlm_sessions [list|--trace|read <file>|grep [-t] <pattern>]", 2)
    list_sessions(command == "--trace")
elif command == "read":
    if len(arguments) != 1:
        fail("Usage: rlm_sessions read <file|--last>", 2)
    if arguments[0] == "--last":
        entries = session_entries()
        if not entries:
            fail("No sessions found.")
        selected = max(entries, key=lambda item: item.mtime_ns)
        render(selected.name)
    else:
        render(checked_name(arguments[0]))
elif command == "grep":
    trace_only = bool(arguments and arguments[0] == "-t")
    if trace_only:
        arguments.pop(0)
    if len(arguments) != 1:
        fail("Usage: rlm_sessions grep [-t] <pattern>", 2)
    grep_sessions(arguments[0], trace_only)
else:
    fail("Usage: rlm_sessions [list|--trace|read <file>|grep [-t] <pattern>]", 2)

session_owner.close()
