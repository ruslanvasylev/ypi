#!/bin/bash
# Check the exact repository Pi candidate against the latest stable release.
# This command is deliberately non-installing: host promotion happens only
# after repository, configured-extension, Honcho, and recursion gates pass.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PI_PACKAGE="${PI_PACKAGE:-@earendil-works/pi-coding-agent}"
DRY_RUN=false
LIVE=false

usage() {
	cat <<'USAGE'
Usage: scripts/check-upstream [--dry-run] [--live]

  --dry-run  Verify latest-version identity only; do not run test gates.
  --live     After deterministic gates, run paid extension and recursion E2E tests.

This command never installs or replaces the host Pi. Stage package.json,
bun.lock, .pi-version, node_modules, and pi-mono coherently on a feature branch,
then rerun this check. Host promotion is a separate post-proof step.
USAGE
}

for arg in "$@"; do
	case "$arg" in
		--dry-run) DRY_RUN=true ;;
		--live) LIVE=true ;;
		--install)
			printf 'check-upstream does not install the host Pi; prove the repository candidate first, then promote the existing host installation with an explicit rollback.\n' >&2
			exit 2
			;;
		-h|--help) usage; exit 0 ;;
		*) printf 'unknown argument: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
	esac
done

if ! command -v bun >/dev/null 2>&1; then
	printf 'bun is required to query the upstream package version\n' >&2
	exit 2
fi

LATEST="${YPI_LATEST_PI_VERSION:-}"
if [ -z "$LATEST" ]; then
	LATEST="$(bun pm view "$PI_PACKAGE" version 2>/dev/null | tail -1 | tr -d '[:space:]' || true)"
fi
if [ -z "$LATEST" ]; then
	printf 'could not determine the latest stable version for %s\n' "$PI_PACKAGE" >&2
	exit 2
fi

printf 'Latest stable Pi: %s\n' "$LATEST"
if ! YPI_EXPECTED_PI_VERSION="$LATEST" "$PROJECT_DIR/scripts/check-pi-version-alignment"; then
	printf '\nRepository candidate is not coherently staged at %s.\n' "$LATEST" >&2
	printf 'Update package.json/bun.lock, .pi-version, node_modules, and pi-mono together on a feature branch, then rerun this command.\n' >&2
	exit 1
fi

if [ "$DRY_RUN" = true ]; then
	printf 'UPSTREAM_CHECK=PASS mode=identity-only version=%s\n' "$LATEST"
	exit 0
fi

cd "$PROJECT_DIR"
export YPI_PI_BIN="$PROJECT_DIR/node_modules/.bin/pi"
ACTUAL="$($YPI_PI_BIN --version 2>/dev/null | tr -d '[:space:]')"
if [ "$ACTUAL" != "$LATEST" ]; then
	printf 'refusing tests: YPI_PI_BIN reports %s, expected %s\n' "$ACTUAL" "$LATEST" >&2
	exit 1
fi

make test-fast
make test-extensions

if [ "$LIVE" = true ]; then
	make test-extensions-e2e
	make test-recursion-e2e
fi

printf 'UPSTREAM_CHECK=PASS mode=%s version=%s binary=%s\n' "$([ "$LIVE" = true ] && printf live || printf deterministic)" "$LATEST" "$YPI_PI_BIN"
